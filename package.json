    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/bcryptjs": "^2.4.6",
    "@xenova/transformers": "^2.17.2",
