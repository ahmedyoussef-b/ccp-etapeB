    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^16.4.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "happy-dom": "^20.11.2",
