    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "14.2.35",
    "next-auth": "^4.24.11",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.0",
    "shadcn": "^4.16.0",
    "sonner": "^1.7.0",
