{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bdd": "cucumber-js",
    "test:bdd:dev": "cucumber-js --profile dev",
    "test:bdd:smoke": "cucumber-js --tags @smoke",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "cleanup:media": "tsx scripts/cleanup-media-registry.ts",
    "compress-data": "tsx scripts/compress-data.ts",
    "compress-data:dry": "tsx scripts/compress-data.ts --dry-run",
    "compress-data:verbose": "tsx scripts/compress-data.ts --verbose",
    "test:perf": "vitest run src/lib/db/compression.perf.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
