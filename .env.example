# ============================================
# AUTHENTICATION & SECURITY
# ============================================
AUTH_ADMIN_FIRST_NAME=admin
AUTH_ADMIN_LAST_NAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_SECRET=change_me_auth_secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nexthub_secret

# ============================================
# AI SERVICES
# ============================================
GROQ_API_KEY=change_me_groq_api_key
GOOGLE_GENAI_API_KEY=change_me_google_genai_api_key

# GitHub Configuration
GITHUB_TOKEN=change_me_github_token
GITHUB_OWNER=your_github_owner
GITHUB_REPO=your_repo
GITHUB_BRANCH=main

# Next.js Configuration (pour le frontend)
NEXT_PUBLIC_GITHUB_OWNER=your_github_owner
NEXT_PUBLIC_GITHUB_REPO=your_repo
NEXT_PUBLIC_GITHUB_BRANCH=main

# ============================================
# DATABASE
# ============================================
# Development: local PostgreSQL
# Copiez ce bloc dans .env.local pour le dev local
#DATABASE_URL=postgresql://postgres:password123@localhost:5432/ccp_etape_b
#NEXT_PUBLIC_DATABASE_URL=postgresql://postgres:password123@localhost:5432/ccp_etape_b

# Production: Neon PostgreSQL
# Pour la production, definissez ces variables dans votre plateforme de deploiement (Vercel, etc.)
# ou dans .env.production pour les tests locaux en mode production.
DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require
NEXT_PUBLIC_DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# ============================================
# VECTOR STORES
# ============================================
CHROMA_URL=http://127.0.0.1:8000
CHROMA_DB_PATH=./chroma-data
WEAVIATE_URL=your_weaviate_url
WEAVIATE_API_KEY=change_me_weaviate_api_key

# ============================================
# STORAGE
# ============================================
BLOB_READ_WRITE_TOKEN=change_me_vercel_blob_token

# ============================================
# APP CONFIGURATION
# ============================================
DATA_PROVIDER=neon
NEXT_PUBLIC_APP_MODE=dev
