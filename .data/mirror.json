                    "type": "file",
                    "metadata": "{\n  \"_id\": \"proc-crf-startup-001\",\n  \"_version\": \"1.0\",\n  \"_type\": \"industrial_procedure\",\n  \"metadata\": {\n    \"title\": \"Démarrage de la pompe CRF - Système de Réfrigération Principal\",\n    \"code\": \"CRF-START-001\",\n    \"category\": \"startup\",\n    \"subcategory\": \"pump_startup\",\n    \"department\": \"Production\",\n    \"criticality\": \"critical\",\n    \"version\": \"1.0\",\n    \"author\": {\n      \"id\": \"user-maint-001\",\n      \"name\": \"Équipe Maintenance CRF\",\n      \"role\": \"maintenance_engineer\",\n      \"department\": \"Maintenance\"\n    },\n    \"approvers\": [\n      {\n        \"id\": \"user-supervisor-001\",\n        \"name\": \"ahmed abbes\",\n        \"role\": \"chef de bloc\",\n        \"approvalDate\": \"2025-01-15T10:00:00Z\"\n      }\n    ],\n    \"createdAt\": \"2026-07-07T17:23:43.786Z\",\n    \"lastUpdated\": \"2026-07-07T17:23:43.787Z\",\n    \"reviewDate\": \"2025-07-15T00:00:00Z\",\n    \"tags\": [\n      \"CRF\",\n      \"refrigeration\",\n      \"startup\",\n      \"critical\",\n      \"pump\"\n    ],\n    \"language\": \"fr-FR\"\n  },\n  \"prerequisites\": {\n    \"description\": \"Conditions obligatoires avant le démarrage de la procédure\",\n    \"items\": [\n      {\n        \"id\": \"pr-001\",\n        \"description\": \"Niveau du bassin d'aspiration supérieur à -5,00 m\",\n        \"condition\": \"level > -5.00\",\n        \"expectedState\": \"OK\",\n        \"verificationType\": \"manual\",\n        \"displayName\": \"Niveau bassin d'aspiration\",\n        \"unit\": \"m\",\n        \"threshold\": -5,\n        \"operator\": \">\",\n        \"manualCheckInstruction\": \"Veuillez vérifier visuellement le niveau du bassin d'aspiration et confirmer qu'il est supérieur à moins cinq mètres\"\n      },\n      {\n        \"id\": \"pr-002\",\n        \"description\": \"Unité hydraulique 001 GO opérationnelle\",\n        \"condition\": \"hydraulic_unit_001 == ON\",\n        \"expectedState\": \"OK\",\n        \"verificationType\": \"manual\",\n        \"displayName\": \"État unité hydraulique\",\n        \"manualCheckInstruction\": \"Veuillez vérifier que l'unité hydraulique 001 GO est opérationnelle et confirmer son état\"\n      },\n      {\n        \"id\": \"pr-003\",\n        \"description\": \"Vanne d'aspiration manuelle ouverte\",\n        \"condition\": \"valve_aspiration == OPEN\",\n        \"expectedState\": \"OK\",\n        \"verificationType\": \"manual\",\n        \"displayName\": \"Position vanne aspiration\",\n        \"expectedPosition\": \"OPEN\",\n        \"manualCheckInstruction\": \"Veuillez vérifier que la vanne d'aspiration manuelle est ouverte et confirmer sa position\"\n      },\n      {\n        \"id\": \"pr-004\",\n        \"description\": \"Vanne clapet de refoulement initialement fermée\",\n        \"condition\": \"valve_discharge == CLOSED\",\n        \"expectedState\": \"OK\",\n        \"verificationType\": \"manual\",\n        \"displayName\": \"Position vanne refoulement\",\n        \"expectedPosition\": \"CLOSED\",\n        \"manualCheckInstruction\": \"Veuillez vérifier que la vanne clapet de refoulement est fermée et confirmer sa position\"\n      }\n    ]\n  },\n  \"steps\": [\n    {\n      \"id\": \"step-001\",\n      \"order\": 1,\n      \"title\": \"Lavage de la grille rotative CFI\",\n      \"subtitle\": \"Séquence automatique de nettoyage\",\n      \"description\": \"L'ordre de démarrage lance automatiquement une séquence de lavage de la grille rotative CFI. Le moteur ne sera mis sous tension qu'après 6 minutes de lavage.\",\n      \"duration\": {\n        \"value\": 360,\n        \"unit\": \"seconds\",\n        \"display\": \"6 minutes\",\n        \"type\": \"fixed\"\n      },\n      \"action\": {\n        \"type\": \"confirmation\",\n        \"instruction\": \"Vérifier que la séquence de lavage CFI est bien en cours d'exécution\",\n        \"expectedConfirmation\": \"Séquence de lavage démarrée\",\n        \"ui\": {\n          \"component\": \"confirmation_button\",\n          \"label\": \"Confirmer le lavage\",\n          \"icon\": \"check_circle\"\n        }\n      },\n      \"validation\": {\n        \"conditions\": [\n          {\n            \"id\": \"val-001\",\n            \"description\": \"Perte de charge à travers la grille rotative\",\n            \"type\": \"pressure\",\n            \"operator\": \"<\",\n            \"value\": 200,\n            \"unit\": \"mmCE\",\n            \"displayName\": \"Perte de charge grille\",\n            \"monitoring\": true\n          }\n        ],\n        \"successExpression\": \"pressure_diff < 200\",\n        \"timeout\": {\n          \"value\": 420,\n          \"unit\": \"seconds\",\n          \"action\": \"abort\"\n        }\n      },\n      \"alarms\": [\n        {\n          \"id\": \"alarm-001\",\n          \"code\": \"CFI-001\",\n          \"type\": \"warning\",\n          \"severity\": \"high\",\n          \"description\": \"Perte de charge excessive sur la grille rotative\",\n          \"condition\": \"pressure_diff >= 200\",\n          \"remedy\": {\n            \"title\": \"Nettoyage manuel de la grille\",\n            \"description\": \"Arrêter la pompe, isoler la section, procéder au nettoyage manuel de la grille rotative\",\n            \"steps\": [\n              \"Arrêter la pompe CRF\",\n              \"Isoler la section de la grille\",\n              \"Ouvrir le carter d'inspection\",\n              \"Nettoyer manuellement la grille\",\n              \"Refermer le carter\",\n              \"Désisoler la section\",\n              \"Reprendre la procédure\"\n            ],\n            \"estimatedTime\": 600,\n            \"tools\": [\n              \"Brosse métallique\",\n              \"Chiffon\",\n              \"Nettoyant industriel\"\n            ],\n            \"safety\": [\n              \"Gants\",\n              \"Lunettes de protection\"\n            ]\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 2,\n            \"contact\": \"supervisor\",\n            \"message\": \"Perte de charge CFI persistante - Inspection requise\"\n          },\n          \"triggerBeforeEnd\": 60\n        }\n      ],\n      \"fallbacks\": [\n        {\n          \"id\": \"fallback-001\",\n          \"title\": \"Dérivation de la grille CFI\",\n          \"description\": \"Si le nettoyage manuel ne résout pas le problème, utiliser la ligne de dérivation\",\n          \"condition\": \"pressure_diff >= 200 AND manual_cleaning_attempts >= 2\",\n          \"action\": \"Ouvrir la vanne de dérivation, fermer les vannes d'isolement de la grille\",\n          \"estimatedTime\": 120\n        }\n      ],\n      \"dependencies\": {\n        \"prerequisites\": [\n          \"pr-001\",\n          \"pr-002\",\n          \"pr-003\",\n          \"pr-004\"\n        ],\n        \"dependsOn\": [],\n        \"requiresConfirmation\": true\n      },\n      \"media\": {\n        \"image\": {\n          \"url\": \"/media/procedures/crf/grille-cfi.jpg\",\n          \"caption\": \"Grille rotative CFI - Vue générale\",\n          \"alt\": \"Photo de la grille rotative CFI\"\n        },\n        \"diagram\": {\n          \"url\": \"/media/procedures/crf/cfi-diagram.pdf\",\n          \"caption\": \"Schéma de la séquence CFI\"\n        },\n        \"video\": {\n          \"url\": \"/media/procedures/crf/cfi-cleaning.mp4\",\n          \"caption\": \"Vidéo de démonstration du lavage CFI\"\n        }\n      },\n      \"notes\": [\n        \"Vérifier visuellement le démarrage du lavage\",\n        \"Écouter les bruits anormaux\",\n        \"Surveiller les indicateurs de pression\"\n      ]\n    },\n    {\n      \"id\": \"step-002\",\n      \"order\": 2,\n      \"title\": \"Mise sous tension du moteur CRF\",\n      \"subtitle\": \"Activation du moteur principal\",\n      \"description\": \"Mise sous tension du moteur de la pompe CRF après 6 minutes de lavage CFI\",\n      \"duration\": {\n        \"value\": 10,\n        \"unit\": \"seconds\",\n        \"display\": \"10 secondes\",\n        \"type\": \"fixed\"\n      },\n      \"action\": {\n        \"type\": \"command\",\n        \"instruction\": \"Lancer la mise sous tension du moteur CRF depuis la salle de contrôle\",\n        \"command\": \"START_MOTOR\",\n        \"parameters\": {\n          \"motorId\": \"CRF-M-001\",\n          \"startMode\": \"automatic\"\n        },\n        \"ui\": {\n          \"component\": \"action_button\",\n          \"label\": \"Démarrer le moteur\",\n          \"icon\": \"play_arrow\",\n          \"color\": \"success\"\n        }\n      },\n      \"validation\": {\n        \"conditions\": [\n          {\n            \"id\": \"val-002\",\n            \"description\": \"Moteur en fonctionnement\",\n            \"type\": \"status\",\n            \"operator\": \"==\",\n            \"value\": \"RUNNING\",\n            \"displayName\": \"État du moteur\"\n          },\n          {\n            \"id\": \"val-003\",\n            \"description\": \"Tension nominale atteinte\",\n            \"type\": \"voltage\",\n            \"operator\": \">=\",\n            \"value\": 380,\n            \"unit\": \"V\",\n            \"displayName\": \"Tension moteur\"\n          }\n        ],\n        \"successExpression\": \"motor_status == RUNNING AND voltage >= 380\",\n        \"timeout\": {\n          \"value\": 30,\n          \"unit\": \"seconds\",\n          \"action\": \"abort\"\n        }\n      },\n      \"alarms\": [\n        {\n          \"id\": \"alarm-002\",\n          \"code\": \"CRF-002\",\n          \"type\": \"warning\",\n          \"severity\": \"medium\",\n          \"description\": \"Fin de la mise sous tension imminente\",\n          \"condition\": \"time_elapsed >= 5\",\n          \"remedy\": {\n            \"title\": \"Préparation à la fin de la mise sous tension\",\n            \"description\": \"La mise sous tension touche à sa fin, préparez-vous pour l'étape suivante\",\n            \"steps\": [\n              \"Surveiller les indicateurs de tension\",\n              \"Préparer les commandes pour l'étape suivante\"\n            ],\n            \"estimatedTime\": 60\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"electrical_team\",\n            \"message\": \"Fin de mise sous tension - Préparation étape suivante\"\n          },\n          \"triggerBeforeEnd\": 5\n        },\n        {\n          \"id\": \"alarm-002b\",\n          \"code\": \"CRF-002B\",\n          \"type\": \"critical\",\n          \"severity\": \"critical\",\n          \"description\": \"Défaut de mise sous tension du moteur CRF\",\n          \"condition\": \"motor_status == FAULT OR voltage < 380\",\n          \"remedy\": {\n            \"title\": \"Diagnostic électrique du moteur\",\n            \"description\": \"Vérifier les alimentations, les protections et les circuits de commande\",\n            \"steps\": [\n              \"Vérifier la présence de tension en amont\",\n              \"Contrôler les disjoncteurs et fusibles\",\n              \"Tester les circuits de commande\",\n              \"Vérifier le SSR (Solid State Relay)\",\n              \"Contrôler l'enroulement du moteur\",\n              \"Réarmer si nécessaire\"\n            ],\n            \"estimatedTime\": 300,\n            \"tools\": [\n              \"Multimètre\",\n              \"Pince ampèremétrique\",\n              \"Plans électriques\"\n            ],\n            \"safety\": [\n              \"Équipement électrique isolé\",\n              \"Vérifier l'absence de tension\"\n            ]\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"electrical_team\",\n            \"message\": \"Défaut électrique CRF persistant\"\n          }\n        }\n      ],\n      \"fallbacks\": [\n        {\n          \"id\": \"fallback-002\",\n          \"title\": \"Démarrage manuel du moteur\",\n          \"description\": \"Utilisation du mode manuel pour le démarrage\",\n          \"condition\": \"motor_start_automatic FAILED\",\n          \"action\": \"Passer en mode manuel, démarrer le moteur via le pupitre local\",\n          \"estimatedTime\": 180\n        }\n      ],\n      \"dependencies\": {\n        \"prerequisites\": [],\n        \"dependsOn\": [\n          \"step-001\"\n        ],\n        \"requiresConfirmation\": true\n      },\n      \"media\": {\n        \"video\": {\n          \"url\": \"/media/procedures/crf/motor-start.mp4\",\n          \"caption\": \"Vidéo de démarrage du moteur CRF\"\n        }\n      },\n      \"notes\": [\n        \"Surveiller les courants de démarrage\",\n        \"Écouter les bruits du moteur\",\n        \"Vérifier le sens de rotation\"\n      ]\n    },\n    {\n      \"id\": \"step-003\",\n      \"order\": 3,\n      \"title\": \"Ouverture vanne de refoulement - Palier 1\",\n      \"subtitle\": \"Phase d'ouverture rapide 0→30%\",\n      \"description\": \"Ouverture rapide de la vanne de refoulement de 0% à 30% en 54 secondes\",\n      \"duration\": {\n        \"value\": 54,\n        \"unit\": \"seconds\",\n        \"display\": \"54 secondes\",\n        \"type\": \"fixed\",\n        \"animation\": true\n      },\n      \"action\": {\n        \"type\": \"valve_operation\",\n        \"instruction\": \"Lancer l'ouverture rapide de la vanne UV-101 vers 30%\",\n        \"valveId\": \"UV-101\",\n        \"operation\": \"open\",\n        \"target\": 30,\n        \"speed\": \"rapid\",\n        \"parameters\": {\n          \"rampTime\": 54,\n          \"intermediateChecks\": true\n        },\n        \"ui\": {\n          \"component\": \"valve_control\",\n          \"label\": \"Ouvrir vanne (30%)\",\n          \"icon\": \"valve_open\",\n          \"showProgress\": true,\n          \"progressDuration\": 54\n        }\n      },\n      \"validation\": {\n        \"conditions\": [\n          {\n            \"id\": \"val-004\",\n            \"description\": \"Position vanne UV-101\",\n            \"type\": \"position\",\n            \"operator\": \"==\",\n            \"value\": 30,\n            \"unit\": \"%\",\n            \"displayName\": \"Position vanne\",\n            \"monitoring\": true,\n            \"tolerance\": 2\n          },\n          {\n            \"id\": \"val-005\",\n            \"description\": \"Pression refoulement\",\n            \"type\": \"pressure\",\n            \"operator\": \">\",\n            \"value\": 0,\n            \"unit\": \"bar\",\n            \"displayName\": \"Pression refoulement\"\n          }\n        ],\n        \"successExpression\": \"valve_position >= 28 AND valve_position <= 32 AND discharge_pressure > 0\",\n        \"timeout\": {\n          \"value\": 60,\n          \"unit\": \"seconds\",\n          \"action\": \"abort\"\n        }\n      },\n      \"alarms\": [\n        {\n          \"id\": \"alarm-003\",\n          \"code\": \"CRF-003\",\n          \"type\": \"warning\",\n          \"severity\": \"medium\",\n          \"description\": \"Fin de l'ouverture de vanne imminente\",\n          \"condition\": \"time_elapsed >= 44\",\n          \"remedy\": {\n            \"title\": \"Préparation à la fin d'ouverture\",\n            \"description\": \"L'ouverture de la vanne touche à sa fin, préparez-vous pour la phase de stabilisation\",\n            \"steps\": [\n              \"Surveiller la position de la vanne\",\n              \"Préparer les vérifications pour la stabilisation\"\n            ],\n            \"estimatedTime\": 60\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"instrumentation_team\",\n            \"message\": \"Fin d'ouverture vanne UV-101 - Préparation stabilisation\"\n          },\n          \"triggerBeforeEnd\": 10\n        },\n        {\n          \"id\": \"alarm-003b\",\n          \"code\": \"CRF-003B\",\n          \"type\": \"critical\",\n          \"severity\": \"critical\",\n          \"description\": \"Défaut d'ouverture de la vanne UV-101\",\n          \"condition\": \"valve_position < 28\",\n          \"remedy\": {\n            \"title\": \"Vérification circuit hydraulique vanne\",\n            \"description\": \"Diagnostic du circuit de commande de la vanne\",\n            \"steps\": [\n              \"Vérifier la pression hydraulique\",\n              \"Contrôler les filtres du circuit\",\n              \"Tester les solénoïdes de commande\",\n              \"Vérifier l'alimentation 24V\",\n              \"Contrôler la tige de vanne\",\n              \"Vérifier la position des fin de course\"\n            ],\n            \"estimatedTime\": 300,\n            \"tools\": [\n              \"Manomètre\",\n              \"Multimètre\",\n              \"Clés\"\n            ],\n            \"safety\": [\n              \"Éviter les projections d'huile\",\n              \"Gants\"\n            ]\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"instrumentation_team\",\n            \"message\": \"Défaut vanne UV-101 CRF\"\n          }\n        }\n      ],\n      \"fallbacks\": [\n        {\n          \"id\": \"fallback-003\",\n          \"title\": \"Ouverture manuelle de la vanne\",\n          \"description\": \"Utilisation de la commande manuelle de secours\",\n          \"condition\": \"valve_auto_open FAILED\",\n          \"action\": \"Passer en mode manuel, ouvrir la vanne à 30% via la pompe hydraulique manuelle\",\n          \"estimatedTime\": 300\n        }\n      ],\n      \"dependencies\": {\n        \"prerequisites\": [],\n        \"dependsOn\": [\n          \"step-002\"\n        ],\n        \"requiresConfirmation\": false\n      },\n      \"media\": {\n        \"image\": {\n          \"url\": \"/media/procedures/crf/valve-uv101.jpg\",\n          \"caption\": \"Vanne de refoulement UV-101\",\n          \"alt\": \"Photo vanne UV-101\"\n        }\n      },\n      \"notes\": [\n        \"Surveiller la pression pendant l'ouverture\",\n        \"Vérifier l'absence de vibrations anormales\",\n        \"Écouter les bruits d'écoulement\"\n      ]\n    },\n    {\n      \"id\": \"step-004\",\n      \"order\": 4,\n      \"title\": \"Stabilisation du remplissage - Palier 2\",\n      \"subtitle\": \"Phase de maintien à 30%\",\n      \"description\": \"Maintien à 30% pendant 150 secondes pour stabiliser le remplissage de la tuyauterie BONNA et éviter les coups de bélier\",\n      \"duration\": {\n        \"value\": 150,\n        \"unit\": \"seconds\",\n        \"display\": \"2 minutes 30 secondes\",\n        \"type\": \"fixed\",\n        \"countdown\": true\n      },\n      \"action\": {\n        \"type\": \"wait\",\n        \"instruction\": \"Maintenir la vanne à 30% pour la phase de stabilisation\",\n        \"parameters\": {\n          \"waitMessage\": \"Stabilisation du remplissage en cours\",\n          \"autoProceed\": true\n        },\n        \"ui\": {\n          \"component\": \"countdown_timer\",\n          \"label\": \"Stabilisation en cours\",\n          \"duration\": 150,\n          \"showProgress\": true,\n          \"showMessage\": true\n        }\n      },\n      \"validation\": {\n        \"conditions\": [\n          {\n            \"id\": \"val-006\",\n            \"description\": \"Pression dans tuyauterie BONNA\",\n            \"type\": \"pressure\",\n            \"operator\": \">\",\n            \"value\": 0,\n            \"unit\": \"bar\",\n            \"displayName\": \"Pression tuyauterie\"\n          },\n          {\n            \"id\": \"val-007\",\n            \"description\": \"Absence de coups de bélier\",\n            \"type\": \"manual\",\n            \"displayName\": \"Stabilité du remplissage\",\n            \"manualCheckInstruction\": \"Vérifier l'absence de coups de bélier ou de vibrations anormales\"\n          },\n          {\n            \"id\": \"val-008\",\n            \"description\": \"Temps de stabilisation écoulé\",\n            \"type\": \"time\",\n            \"operator\": \">=\",\n            \"value\": 150,\n            \"unit\": \"seconds\",\n            \"displayName\": \"Temps de stabilisation\"\n          }\n        ],\n        \"successExpression\": \"time_elapsed >= 150 AND pressure > 0\",\n        \"timeout\": {\n          \"value\": 180,\n          \"unit\": \"seconds\",\n          \"action\": \"warn\"\n        }\n      },\n      \"alarms\": [\n        {\n          \"id\": \"alarm-004\",\n          \"code\": \"CRF-004\",\n          \"type\": \"warning\",\n          \"severity\": \"medium\",\n          \"description\": \"Fin de la stabilisation imminente\",\n          \"condition\": \"time_elapsed >= 120\",\n          \"remedy\": {\n            \"title\": \"Préparation à la fin de stabilisation\",\n            \"description\": \"La phase de stabilisation touche à sa fin, préparez-vous pour l'ouverture finale\",\n            \"steps\": [\n              \"Vérifier la pression dans la tuyauterie\",\n              \"Confirmer l'absence de coups de bélier\",\n              \"Préparer les commandes pour l'ouverture finale\"\n            ],\n            \"estimatedTime\": 120\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"operator\",\n            \"message\": \"Fin de stabilisation - Préparation ouverture finale\"\n          },\n          \"triggerBeforeEnd\": 30\n        },\n        {\n          \"id\": \"alarm-004b\",\n          \"code\": \"CRF-004B\",\n          \"type\": \"critical\",\n          \"severity\": \"critical\",\n          \"description\": \"Pression excessive dans la tuyauterie BONNA\",\n          \"condition\": \"pressure > 50\",\n          \"remedy\": {\n            \"title\": \"Réduction d'urgence de la pression\",\n            \"description\": \"Réduction immédiate de la pression pour éviter les dégâts\",\n            \"steps\": [\n              \"Réduire l'ouverture de la vanne UV-101\",\n              \"Ouvrir la vanne de purge\",\n              \"Vérifier les indicateurs de pression\",\n              \"Attendre la stabilisation de la pression\",\n              \"Fermer la vanne de purge\"\n            ],\n            \"estimatedTime\": 120,\n            \"tools\": [\n              \"Clé vanne\",\n              \"Manomètre\"\n            ],\n            \"safety\": [\n              \"Zone sécurisée\",\n              \"Éviter les projections\"\n            ]\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"emergency_team\",\n            \"message\": \"Surcharge pression CRF - Intervention d'urgence\"\n          }\n        }\n      ],\n      \"fallbacks\": [],\n      \"dependencies\": {\n        \"prerequisites\": [],\n        \"dependsOn\": [\n          \"step-003\"\n        ],\n        \"requiresConfirmation\": false\n      },\n      \"media\": {\n        \"image\": {\n          \"url\": \"/media/procedures/crf/bonna-piping.jpg\",\n          \"caption\": \"Tuyauterie BONNA\",\n          \"alt\": \"Photo tuyauterie BONNA\"\n        }\n      },\n      \"notes\": [\n        \"Surveiller les indicateurs de pression en continu\",\n        \"Vérifier l'absence de fuites\",\n        \"Écouter les bruits d'écoulement\"\n      ]\n    },\n    {\n      \"id\": \"step-005\",\n      \"order\": 5,\n      \"title\": \"Ouverture finale vanne - Palier 3\",\n      \"subtitle\": \"Phase d'ouverture 30→100%\",\n      \"description\": \"Ouverture finale de 30% à 100% en 126 secondes\",\n      \"duration\": {\n        \"value\": 126,\n        \"unit\": \"seconds\",\n        \"display\": \"2 minutes 6 secondes\",\n        \"type\": \"fixed\"\n      },\n      \"action\": {\n        \"type\": \"valve_operation\",\n        \"instruction\": \"Lancer l'ouverture finale de la vanne UV-101 vers 100%\",\n        \"valveId\": \"UV-101\",\n        \"operation\": \"open\",\n        \"target\": 100,\n        \"speed\": \"progressive\",\n        \"parameters\": {\n          \"rampTime\": 126,\n          \"intermediateChecks\": true,\n          \"checkInterval\": 30\n        },\n        \"ui\": {\n          \"component\": \"valve_control\",\n          \"label\": \"Ouvrir vanne (100%)\",\n          \"icon\": \"valve_open_full\",\n          \"showProgress\": true,\n          \"progressDuration\": 126\n        }\n      },\n      \"validation\": {\n        \"conditions\": [\n          {\n            \"id\": \"val-009\",\n            \"description\": \"Position vanne UV-101\",\n            \"type\": \"position\",\n            \"operator\": \"==\",\n            \"value\": 100,\n            \"unit\": \"%\",\n            \"displayName\": \"Position vanne\",\n            \"monitoring\": true,\n            \"tolerance\": 2\n          },\n          {\n            \"id\": \"val-010\",\n            \"description\": \"Température paliers moteur\",\n            \"type\": \"temperature\",\n            \"operator\": \"<\",\n            \"value\": 90,\n            \"unit\": \"°C\",\n            \"displayName\": \"Température paliers\",\n            \"monitoring\": true,\n            \"critical\": true\n          },\n          {\n            \"id\": \"val-011\",\n            \"description\": \"Pression différentielle correcte\",\n            \"type\": \"pressure\",\n            \"operator\": \"<\",\n            \"value\": 20,\n            \"unit\": \"bar\",\n            \"displayName\": \"Pression différentielle\"\n          }\n        ],\n        \"successExpression\": \"valve_position >= 98 AND valve_position <= 102 AND bearing_temp < 90 AND diff_pressure < 20\",\n        \"timeout\": {\n          \"value\": 140,\n          \"unit\": \"seconds\",\n          \"action\": \"abort\"\n        }\n      },\n      \"alarms\": [\n        {\n          \"id\": \"alarm-005\",\n          \"code\": \"CRF-005\",\n          \"type\": \"critical\",\n          \"severity\": \"critical\",\n          \"description\": \"Température excessive des paliers\",\n          \"condition\": \"bearing_temp >= 90\",\n          \"remedy\": {\n            \"title\": \"Refroidissement des paliers\",\n            \"description\": \"Réduire la charge et vérifier le refroidissement\",\n            \"steps\": [\n              \"Réduire l'ouverture de la vanne\",\n              \"Vérifier le circuit de lubrification\",\n              \"Vérifier le refroidisseur d'huile\",\n              \"Contrôler le débit d'huile\",\n              \"Augmenter le refroidissement si possible\",\n              \"Reprendre l'ouverture progressivement\"\n            ],\n            \"estimatedTime\": 600,\n            \"tools\": [\n              \"Thermomètre\",\n              \"Débitmètre\"\n            ],\n            \"safety\": [\n              \"Gants thermiques\",\n              \"Zone ventilée\"\n            ]\n          },\n          \"escalation\": {\n            \"ifPersistsAfter\": 1,\n            \"contact\": \"maintenance_team\",\n            \"message\": \"Température paliers CRF excessive\"\n          }\n        },\n        {\n          \"id\": \"alarm-006\",\n          \"code\": \"CRF-006\",\n          \"type\": \"warning\",\n          \"severity\": \"medium\",\n          \"description\": \"Pression différentielle anormale\",\n          \"condition\": \"diff_pressure >= 20\",\n          \"remedy\": {\n            \"title\": \"Vérification du circuit\",\n            \"description\": \"Vérifier le circuit et les filtres\",\n            \"steps\": [\n              \"Vérifier l'encrassement des filtres\",\n              \"Contrôler les vannes\",\n              \"Vérifier les prises de pression\",\n              \"Tester les transmetteurs\"\n            ],\n            \"estimatedTime\": 300\n          },\n          \"triggerBeforeEnd\": 20\n        }\n      ],\n      \"fallbacks\": [],\n      \"dependencies\": {\n        \"prerequisites\": [],\n        \"dependsOn\